<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="Selenium.WebDriver" Version="4.52.0" />
    <PackageReference Include="Selenium.Support" Version="4.52.0" />
    <ProjectReference Include="..\www\www.csproj" />
  </ItemGroup>
</Project>
